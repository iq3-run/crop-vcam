<Window x:Class="CropVCam.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CropVCam.App"
        mc:Ignorable="d"
        Title="crop-vcam" Height="480" Width="420"
        ResizeMode="CanMinimize"
        d:DataContext="{d:DesignInstance local:MainViewModel}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 入力 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="入力：" VerticalAlignment="Center" Width="48" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding CameraDevices}"
                      SelectedItem="{Binding SelectedCamera}"
                      DisplayMemberPath="Name"
                      IsEnabled="{Binding CanEditSettings}" />
        </Grid>

        <!-- 倍率 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="倍率：" VerticalAlignment="Center" Width="48" />
            <Slider Grid.Column="1"
                    Minimum="{x:Static local:MainViewModel.MinMagnification}"
                    Maximum="{x:Static local:MainViewModel.MaxMagnification}"
                    TickFrequency="0.5"
                    IsSnapToTickEnabled="False"
                    Value="{Binding Magnification, UpdateSourceTrigger=PropertyChanged}"
                    VerticalAlignment="Center" Margin="4,0" />
            <TextBox Grid.Column="2" Width="48"
                     Text="{Binding Magnification, StringFormat=N1, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="3" Text="倍" VerticalAlignment="Center" Margin="4,0,0,0" />
        </Grid>

        <!-- プレビュー -->
        <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1" Background="Black" Margin="0,0,0,8">
            <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
        </Border>

        <!-- 出力 -->
        <Grid Grid.Row="3" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="出力：" VerticalAlignment="Center" Width="48" />
            <TextBox Grid.Column="1"
                     Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanEditSettings}" />
        </Grid>

        <TextBlock Grid.Row="4" Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,4" />

        <Button Grid.Row="5" Content="{Binding StartStopButtonText}"
                Command="{Binding StartStopCommand}"
                Width="100" Height="32" HorizontalAlignment="Right" />
    </Grid>
</Window>
